# ==============================================================================
# IMAGEKEY - Environment Configuration
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development
APP_NAME=IMAGEKEY
DEBUG=True
HOST=127.0.0.1
PORT=8000

# Security & Authentication
# Generate a secure key in production with: openssl rand -hex 32
SECRET_KEY=dev-secret-key-change-me-in-production-min32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection (PostgreSQL with asyncpg driver)
# For local Docker: postgresql+asyncpg://imagekey_user:imagekey_secret@127.0.0.1:5432/imagekey_db
# For SQLite testing fallback: sqlite+aiosqlite:///./imagekey.db
DATABASE_URL=postgresql+asyncpg://imagekey_user:imagekey_secret@127.0.0.1:5432/imagekey_db
DB_ECHO=False

# File Storage & Upload Security
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_BYTES=5242880  # 5 MB
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp

# Computer Vision & Recognition Thresholds
CONFIDENCE_THRESHOLD_VERIFIED=0.85
CONFIDENCE_THRESHOLD_UNCERTAIN=0.65
HAMMING_DISTANCE_MAX=10

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
